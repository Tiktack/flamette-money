# Better Auth
# Generate a strong secret, for example:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional: set this in production or when you want one fixed public origin.
# For local multi-branch development, you can usually leave it unset and let
# Better Auth accept localhost on any Vite port.
# BETTER_AUTH_URL=http://localhost:5174

# Optional: extra allowed hosts for dynamic Better Auth base URL resolution.
# Localhost hosts are already allowed by default.
# BETTER_AUTH_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*

# Optional: extra trusted origins for auth redirects and origin checks.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4173,https://your-app.example.com

# Database
DATABASE_URL=file:./data/flamette-money.db

# Optional social auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional receipt scanning
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1:free
