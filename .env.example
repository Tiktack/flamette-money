# Better Auth
# Generate a strong secret, for example:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional: set this in production or when you want one fixed public origin.
# For local development, you can leave it unset and Better Auth will accept
# localhost plus *.workers.dev by default.
# BETTER_AUTH_URL=https://your-app.example.com

# Optional: extra allowed hosts for dynamic Better Auth base URL resolution.
# Localhost hosts and *.workers.dev are already allowed by default.
# BETTER_AUTH_ALLOWED_HOSTS=app.example.com,preview.example.com

# Optional: extra trusted origins for auth redirects and origin checks.
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-app.example.com,https://preview.example.com

# Cloudflare D1
# The database itself is configured as the DB binding in wrangler.jsonc.
# There is no DATABASE_URL runtime variable anymore.

# Optional social auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional exchange-rate enrichment
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_HOURS=5

# Optional receipt scanning
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1:free
