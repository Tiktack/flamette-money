# Better Auth
# Generate a strong secret, for example:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional: set this to your fixed public origin in production (for example the
# Cloudflare Tunnel subdomain that points at this app). For local development you
# can leave it unset and Better Auth will accept localhost on any Vite port.
# BETTER_AUTH_URL=https://money.example.com

# Optional: extra allowed hosts for dynamic Better Auth base URL resolution.
# Localhost hosts are already allowed by default.
# BETTER_AUTH_ALLOWED_HOSTS=money.example.com

# Optional: extra trusted origins for auth redirects and origin checks.
# BETTER_AUTH_TRUSTED_ORIGINS=https://money.example.com

# Optional: force secure-cookie behavior. By default it is derived from BETTER_AUTH_URL
# (https => secure). Set to false if you access the app over plain http on your LAN.
# BETTER_AUTH_USE_SECURE_COOKIES=true

# Database (local SQLite file). Defaults to file:./data/flamette-money.db.
# In the Home Assistant add-on this is set to file:/data/flamette-money.db.
DATABASE_URL=file:./data/flamette-money.db

# Optional social auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional exchange-rate enrichment
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_HOURS=5

# Optional receipt scanning
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1:free
