{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "ignorePatterns": [".agents/**", ".claude/**", ".github/**", "dist/**", "src/components/charts/**", "src/lib/api/generated/**", "src/routeTree.gen.ts"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import"],
  "rules": {
    "unicorn/no-array-sort": "off",
    "react/react-in-jsx-scope": "off"
  },
  "settings": {
    "react": {
      "version": "19.2.6"
    }
  }
}
